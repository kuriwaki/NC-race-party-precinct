# Local inputs, caches, intermediate data, and generated outputs.
# Track README placeholders and the explicitly allowed Tyrrell release below.
/data/*
!/data/raw/
!/data/intermediate/
!/data/diagnostics/
/data/raw/*
!/data/raw/README.md
/data/intermediate/*
!/data/intermediate/README.md
/data/diagnostics/*
!/data/diagnostics/README.md
/release/*
!/release/README.md
/cache/
/output/
/outputs/
/scratch/
/logs/

