# Reviewed offline example: allow only these three small, aggregate/public files.
!/examples/tyrrell/inputs/voter-counts.csv
!/examples/tyrrell/inputs/block-groups.geojson
!/examples/tyrrell/inputs/precincts.geojson

# Reviewed Tyrrell release: keep every other release file ignored.
!/release/tyrrell/
/release/tyrrell/*
!/release/tyrrell/nc_vtd_wide.csv
!/release/tyrrell/nc_vtd_geo.rds
!/release/tyrrell/nc_vtd_geo.geojson

# Credentials and machine-specific configuration.
.Renviron
.Renviron.*
.env
.env.*
config/local.yml
config/local.yaml
.DS_Store

# Local package libraries and temporary R files.
/renv/library/
/renv/staging/
*.Rcheck/
*~
